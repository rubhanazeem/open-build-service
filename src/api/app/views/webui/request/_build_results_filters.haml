= form_tag(filter_url, method: :get) do
  - if package_names.size > 1
    = render partial: 'webui/shared/build_result_filter', locals: { id: 'project-monitor-package-dropdown',
                                                                    text: 'Package Name',
                                                                    values: package_names,
                                                                    value_prefix: 'package_',
                                                                    checked_values: filters }
  = render partial: 'webui/shared/build_result_filter', locals: { id: 'project-monitor-repositories-dropdown',
                                                                  text: 'Repository',
                                                                  values: repository_names,
                                                                  value_prefix: 'repo_',
                                                                  checked_values: filters }
  = render partial: 'webui/shared/build_result_filter', locals: { id: 'project-monitor-architectures-dropdown',
                                                                  text: 'Architecture',
                                                                  values: architecture_names,
                                                                  value_prefix: 'arch_',
                                                                  checked_values: filters }
  = render partial: 'webui/shared/build_result_filter', locals: { id: 'project-monitor-status-dropdown',
                                                                  text: 'Status',
                                                                  values: status_names,
                                                                  value_prefix: 'status_',
                                                                  checked_values: filters }
  %button.btn.btn-primary#filter-button{ type: :submit }
    Apply Filter

  .float-end.d-flex
    - if @bs_request && policy(@bs_request).handle_request?
      .dropdown.me-2#request-decision-dropdown
        %button.btn.btn-success.dropdown-toggle{ type: 'button', data: { 'bs-toggle': 'dropdown', 'bs-auto-close': 'outside' },
                                                 aria: { expanded: 'false' } }
          Review
        .dropdown-menu.dropdown-menu-end.p-3.shadow-lg.request-decision-dropdown-menu
          = render RequestDecisionComponent.new(bs_request: @bs_request,
                                                package_maintainers: @package_maintainers,
                                                show_project_maintainer_hint: @show_project_maintainer_hint,
                                                show_add_comment: false,
                                                show_cancel: true)
    = render partial: 'webui/shared/build_status_legend_modal', locals: { legend: Buildresult::STATUS_DESCRIPTION }

- if selected_filters_text.present?
  .mt-3 Selected filters: #{selected_filters_text}
